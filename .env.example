# Copie este arquivo para ".env" e preencha.

# URL do App da Web do Google Apps Script (termina em /exec)
VITE_APPS_SCRIPT_URL=

# OPCIONAL - cadastro por foto e classificação de gênero via IA (OpenAI).
# Sem a chave, o cadastro por foto fica desativado e o gênero vem do Google Books.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# OPCIONAL - chave do Google Books (aumenta a cota de buscas)
VITE_GOOGLE_BOOKS_KEY=
