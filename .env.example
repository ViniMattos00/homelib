# Copie este arquivo para ".env" e preencha.

# URL do App da Web do Google Apps Script (termina em /exec)
VITE_APPS_SCRIPT_URL=

# Chave da OpenAI: usada na busca por texto, no cadastro por foto e para sugerir gênero/páginas.
# Sem a chave, o cadastro é só manual.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
